        // ===== سحب =====
        window.showWithdraw = () => {
            openModal(`
                <h2 class="text-xl font-bold text-dark mb-4 text-center">💰 سحب الأموال</h2>
                <p class="text-dark-light text-sm text-center mb-4">أدخل المبلغ المراد سحبه</p>
                <div class="mb-3">
                    <label class="block text-sm font-bold text-dark mb-1">المبلغ</label>
                    <input type="number" id="withdrawAmount" placeholder="0.00" class="w-full p-3 rounded-xl border-2 border-gray-200 focus:border-blue-500 focus:outline-none bg-white/60">
                </div>
                <div class="mb-3">
                    <label class="block text-sm font-bold text-dark mb-1">طريقة السحب</label>
                    <select id="withdrawMethod" class="w-full p-3 rounded-xl border-2 border-gray-200 focus:border-blue-500 focus:outline-none bg-white/60">
                        <option value="bank">تحويل بنكي</option>
                        <option value="card">بطاقة فيزا</option>
                        <option value="crypto">عملة رقمية</option>
                    </select>
                </div>
                <button onclick="processWithdraw()" class="btn-primary w-full py-3">
                    <i class="fas fa-arrow-up ml-2"></i> تأكيد السحب
                </button>
                <button onclick="closeModal()" class="w-full py-2 mt-2 text-dark-light hover:text-dark">إلغاء</button>
            `);
        };

        window.processWithdraw = async () => {
            const amount = parseFloat(document.getElementById('withdrawAmount').value);
            if (!amount || amount <= 0) {
                showToast('❌ المبلغ غير صحيح', 'error');
                return;
            }
            if (amount > (userData?.balance || 0)) {
                showToast('❌ الرصيد غير كافي', 'error');
                return;
            }
            closeModal();
            showToast('📩 تم إرسال طلب السحب، سيتم معالجته خلال 24 ساعة', 'success');
        };

        // ===== QR =====
        window.showQR = () => {
            const wallet = userData?.walletID || '000000';
            openModal(`
                <h2 class="text-xl font-bold text-dark mb-4 text-center">📱 رمز QR للمحفظة</h2>
                <div class="text-center">
                    <div class="bg-white p-4 rounded-xl inline-block mx-auto mb-4">
                        <img src="https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=${wallet}" alt="QR Code" class="w-48 h-48 mx-auto">
                    </div>
                    <p class="text-dark font-bold">#${wallet}</p>
                    <p class="text-dark-light text-sm">امسح الرمز للتحويل مباشرة</p>
                </div>
                <button onclick="closeModal()" class="w-full py-2 mt-4 text-dark-light hover:text-dark">إغلاق</button>
            `);
        };

        // =============================================
        // ===== TRANSACTIONS =====
        // =============================================
        async function loadRecentTransactions() {
            if (!auth.currentUser) return;
            const container = document.getElementById('recentTransactions');
            try {
                const q = query(collection(db, "transactions"),
                    where("senderId", "==", auth.currentUser.uid),
                    orderBy("createdAt", "desc"),
                    limit(5)
                );
                const snap = await getDocs(q);
                if (snap.empty) {
                    container.innerHTML = '<div class="text-center text-dark-light py-8">لا توجد عمليات حديثة</div>';
                    return;
                }
                let html = '';
                snap.forEach(doc => {
                    const t = doc.data();
                    const isCredit = t.type === 'deposit' || t.receiverId === auth.currentUser.uid;
                    html += `
                        <div class="transaction-item" onclick="showTransactionDetail('${doc.id}')">
                            <div class="transaction-icon ${isCredit ? 'credit' : 'debit'}">
                                <i class="fas ${isCredit ? 'fa-arrow-down' : 'fa-arrow-up'}"></i>
                            </div>
                            <div class="flex-1">
                                <p class="font-bold text-dark">${t.description || 'تحويل'}</p>
                                <p class="text-xs text-dark-light">${new Date(t.createdAt?.seconds * 1000 || Date.now()).toLocaleDateString()}</p>
                            </div>
                            <div class="text-left">
                                <p class="font-bold ${isCredit ? 'text-green-600' : 'text-red-600'}">${isCredit ? '+' : '-'}${t.amount.toLocaleString()} ج.س</p>
                                <p class="text-xs text-dark-light">${t.status || 'مكتمل'}</p>
                            </div>
                        </div>
                    `;
                });
                container.innerHTML = html;
            } catch (error) {
                console.error('Error loading transactions:', error);
            }
        }

        async function loadAllTransactions() {
            if (!auth.currentUser) return;
            const container = document.getElementById('allTransactions');
            try {
                const q = query(collection(db, "transactions"),
                    where("senderId", "==", auth.currentUser.uid),
                    orderBy("createdAt", "desc")
                );
                const snap = await getDocs(q);
                if (snap.empty) {
                    container.innerHTML = '<div class="text-center text-dark-light py-8">لا توجد عمليات</div>';
                    return;
                }
                let html = '';
                snap.forEach(doc => {
                    const t = doc.data();
                    const isCredit = t.type === 'deposit' || t.receiverId === auth.currentUser.uid;
                    html += `
                        <div class="transaction-item" onclick="showTransactionDetail('${doc.id}')">
                            <div class="transaction-icon ${isCredit ? 'credit' : 'debit'}">
                                <i class="fas ${isCredit ? 'fa-arrow-down' : 'fa-arrow-up'}"></i>
                            </div>
                            <div class="flex-1">
                                <p class="font-bold text-dark">${t.description || 'تحويل'}</p>
                                <p class="text-xs text-dark-light">${new Date(t.createdAt?.seconds * 1000 || Date.now()).toLocaleString()}</p>
                            </div>
                            <div class="text-left">
                                <p class="font-bold ${isCredit ? 'text-green-600' : 'text-red-600'}">${isCredit ? '+' : '-'}${t.amount.toLocaleString()} ج.س</p>
                                <p class="text-xs text-dark-light">${t.status || 'مكتمل'}</p>
                            </div>
                        </div>
                    `;
                });
                container.innerHTML = html;
                document.getElementById('totalTransactions').innerText = snap.size;
            } catch (error) {
                console.error('Error loading transactions:', error);
            }
        }

        window.showTransactions = () => {
            showPage('transactions');
            loadAllTransactions();
        };

        window.showTransactionDetail = async (txnId) => {
            try {
                const docSnap = await getDoc(doc(db, "transactions", txnId));
                if (!docSnap.exists) {
                    showToast('❌ العملية غير موجودة', 'error');
                    return;
                }
                const t = docSnap.data();
                const isCredit = t.type === 'deposit' || t.receiverId === auth.currentUser.uid;
                openModal(`
                    <h2 class="text-xl font-bold text-dark mb-4 text-center">📋 تفاصيل العملية</h2>
                    <div class="space-y-2">
                        <div class="flex justify-between p-2 border-b border-gray-100">
                            <span class="text-dark-light">المرجع</span>
                            <span class="font-bold text-dark">${t.reference || txnId}</span>
                        </div>
                        <div class="flex justify-between p-2 border-b border-gray-100">
                            <span class="text-dark-light">الوصف</span>
                            <span class="font-bold text-dark">${t.description || 'تحويل'}</span>
                        </div>
                        <div class="flex justify-between p-2 border-b border-gray-100">
                            <span class="text-dark-light">المبلغ</span>
                            <span class="font-bold ${isCredit ? 'text-green-600' : 'text-red-600'}">${isCredit ? '+' : '-'}${t.amount.toLocaleString()} ج.س</span>
                        </div>
                        <div class="flex justify-between p-2 border-b border-gray-100">
                            <span class="text-dark-light">الرسوم</span>
                            <span class="font-bold text-dark">${(t.fee || 0).toLocaleString()} ج.س</span>
                        </div>
                        <div class="flex justify-between p-2 border-b border-gray-100">
                            <span class="text-dark-light">الحالة</span>
                            <span class="font-bold ${t.status === 'completed' ? 'text-green-600' : 'text-yellow-600'}">${t.status || 'مكتمل'}</span>
                        </div>
                        <div class="flex justify-between p-2 border-b border-gray-100">
                            <span class="text-dark-light">التاريخ</span>
                            <span class="font-bold text-dark">${new Date(t.createdAt?.seconds * 1000 || Date.now()).toLocaleString()}</span>
                        </div>
                        <div class="flex justify-between p-2">
                            <span class="text-dark-light">النوع</span>
                            <span class="font-bold text-dark">${isCredit ? '📥 وارد' : '📤 صادر'}</span>
                        </div>
                    </div>
                    <button onclick="closeModal()" class="w-full py-2 mt-4 text-dark-light hover:text-dark">إغلاق</button>
                `);
            } catch (error) {
                showToast('❌ خطأ في جلب التفاصيل', 'error');
            }
        };

        // =============================================
        // ===== CARDS =====
        // =============================================
        async function loadCards() {
            if (!auth.currentUser) return;
            const container = document.getElementById('cardsList');
            try {
                const userDoc = await getDoc(doc(db, "users", auth.currentUser.uid));
                if (!userDoc.exists) return;
                const data = userDoc.data();
                cards = data.cards || [];

                if (cards.length === 0) {
                    container.innerHTML = `
                        <div class="text-center text-dark-light py-8">
                            <i class="fas fa-credit-card text-4xl mb-3 block"></i>
                            <p>لا توجد بطاقات</p>
                            <button onclick="showCreateCard()" class="btn-primary mt-3 text-sm py-2 px-4">+ إضافة بطاقة</button>
                        </div>
                    `;
                    return;
                }

                let html = '';
                cards.forEach(card => {
                    html += `
                        <div class="glass p-4 rounded-xl mb-3">
                            <div class="flex justify-between items-start">
                                <div>
                                    <p class="font-bold text-dark">${card.brand || 'بطاقة'}</p>
                                    <p class="text-sm text-dark-light">•••• •••• •••• ${card.lastFour || '4242'}</p>
                                </div>
                                <div class="flex gap-2">
                                    <span class="text-xs px-2 py-1 rounded ${card.isActive ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-700'}">
                                        ${card.isActive ? 'نشطة' : 'موقفة'}
                                    </span>
                                </div>
                            </div>
                            <div class="flex justify-between mt-2 text-sm">
                                <span class="text-dark-light">تنتهي: ${card.expiryMonth || 12}/${card.expiryYear || 26}</span>
                                <div class="flex gap-2">
                                    <button onclick="toggleCard('${card.id}')" class="text-blue-600 hover:underline">
                                        ${card.isFrozen ? 'إلغاء التجميد' : 'تجميد'}
                                    </button>
                                    <button onclick="deleteCard('${card.id}')" class="text-red-500 hover:underline">حذف</button>
                                </div>
                            </div>
                        </div>
                    `;
                });
                container.innerHTML = html;
            } catch (error) {
                console.error('Error loading cards:', error);
            }
        }

        window.showCreateCard = () => {
            openModal(`
                <h2 class="text-xl font-bold text-dark mb-4 text-center">💳 إضافة بطاقة جديدة</h2>
                <div class="mb-3">
                    <label class="block text-sm font-bold text-dark mb-1">نوع البطاقة</label>
                    <select id="cardType" class="w-full p-3 rounded-xl border-2 border-gray-200 focus:border-blue-500 focus:outline-none bg-white/60">
                        <option value="virtual">افتراضية</option>
                        <option value="physical">فيزيائية</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="block text-sm font-bold text-dark mb-1">العلامة التجارية</label>
                    <select id="cardBrand" class="w-full p-3 rounded-xl border-2 border-gray-200 focus:border-blue-500 focus:outline-none bg-white/60">
                        <option value="visa">Visa</option>
                        <option value="mastercard">Mastercard</option>
                        <option value="amex">American Express</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="block text-sm font-bold text-dark mb-1">الحد اليومي</label>
                    <input type="number" id="cardDailyLimit" value="5000" class="w-full p-3 rounded-xl border-2 border-gray-200 focus:border-blue-500 focus:outline-none bg-white/60">
                </div>
                <button onclick="createCard()" class="btn-primary w-full py-3">
                    <i class="fas fa-plus ml-2"></i> إنشاء البطاقة
                </button>
                <button onclick="closeModal()" class="w-full py-2 mt-2 text-dark-light hover:text-dark">إلغاء</button>
            `);
        };

        window.createCard = async () => {
            if (!auth.currentUser) return;
            const type = document.getElementById('cardType').value;
            const brand = document.getElementById('cardBrand').value;
            const dailyLimit = parseFloat(document.getElementById('cardDailyLimit').value) || 5000;

            const newCard = {
                id: `card-${Date.now()}`,
                type: type,
                brand: brand,
                lastFour: Math.floor(1000 + Math.random() * 9000).toString(),
                expiryMonth: 12,
                expiryYear: 26,
                dailyLimit: dailyLimit,
                monthlyLimit: dailyLimit * 30,
                dailyUsed: 0,
                monthlyUsed: 0,
                isActive: true,
                isFrozen: false,
                isDefault: true,
                createdAt: new Date().toISOString()
            };

            try {
                const userRef = doc(db, "users", auth.currentUser.uid);
                const userDoc = await getDoc(userRef);
                const data = userDoc.data();
                const cards = data.cards || [];
                cards.push(newCard);

                await updateDoc(userRef, { cards: cards, updatedAt: serverTimestamp() });
                showToast('✅ تم إنشاء البطاقة بنجاح', 'success');
                closeModal();
                loadCards();
            } catch (error) {
                showToast('❌ خطأ: ' + error.message, 'error');
            }
        };

        window.toggleCard = async (cardId) => {
            if (!auth.currentUser) return;
            try {
                const userRef = doc(db, "users", auth.currentUser.uid);
                const userDoc = await getDoc(userRef);
                const data = userDoc.data();
                const cards = data.cards || [];
                const index = cards.findIndex(c => c.id === cardId);
                if (index === -1) return;
                cards[index].isFrozen = !cards[index].isFrozen;
                await updateDoc(userRef, { cards: cards, updatedAt: serverTimestamp() });
                showToast(cards[index].isFrozen ? '✅ تم تجميد البطاقة' : '✅ تم إلغاء التجميد', 'success');
                loadCards();
            } catch (error) {
                showToast('❌ خطأ: ' + error.message, 'error');
            }
        };

        window.deleteCard = async (cardId) => {
            if (!confirm('⚠️ هل أنت متأكد من حذف البطاقة؟')) return;
            if (!auth.currentUser) return;
            try {
                const userRef = doc(db, "users", auth.currentUser.uid);
                const userDoc = await getDoc(userRef);
                const data = userDoc.data();
                const cards = data.cards || [];
                const newCards = cards.filter(c => c.id !== cardId);
                await updateDoc(userRef, { cards: newCards, updatedAt: serverTimestamp() });
                showToast('✅ تم حذف البطاقة', 'success');
                loadCards();
            } catch (error) {
                showToast('❌ خطأ: ' + error.message, 'error');
            }
        };

        // =============================================
        // ===== KYC =====
        // =============================================
        window.submitKYC = async () => {
            if (!auth.currentUser) {
                showToast('❌ يرجى تسجيل الدخول أولاً', 'error');
                return;
            }

            const kycData = {
                idType: document.getElementById('kycType').value,
                idNumber: document.getElementById('kycNumber').value.trim(),
                dateOfBirth: document.getElementById('kycDob').value,
                country: document.getElementById('kycCountry').value.trim()
            };

            if (!kycData.idNumber || !kycData.dateOfBirth || !kycData.country) {
                showToast('❌ جميع الحقول مطلوبة', 'error');
                return;
            }

            try {
                const userRef = doc(db, "users", auth.currentUser.uid);
                await updateDoc(userRef, {
                    kycStatus: 'pending',
                    kycData: kycData,
                    isVerified: false,
                    updatedAt: serverTimestamp()
                });
                showToast('✅ تم إرسال طلب التحقق بنجاح', 'success');
                document.getElementById('kycStatus').innerText = '⏳ قيد المراجعة';
                document.getElementById('kycStatus').style.background = 'rgba(245,158,11,0.3)';
            } catch (error) {
                showToast('❌ خطأ: ' + error.message, 'error');
            }
        };

        // =============================================
        // ===== 2FA =====
        // =============================================
        window.toggle2FA = async () => {
            if (!auth.currentUser) {
                showToast('❌ يرجى تسجيل الدخول أولاً', 'error');
                return;
            }
            try {
                const userRef = doc(db, "users", auth.currentUser.uid);
                const userDoc = await getDoc(userRef);
                const data = userDoc.data();
                const newStatus = !data.twoFactorEnabled;
                await updateDoc(userRef, { twoFactorEnabled: newStatus });
                showToast(newStatus ? '✅ تم تفعيل المصادقة الثنائية' : '❌ تم إلغاء المصادقة الثنائية', 'success');
                if (userData) {
                    userData.twoFactorEnabled = newStatus;
                    document.getElementById('twoFAStatus').innerText = newStatus ? '✅ مفعلة' : '❌ غير مفعلة';
                    document.getElementById('twoFAStatus').style.color = newStatus ? '#16A34A' : '#EF4444';
                }
            } catch (error) {
                showToast('❌ خطأ: ' + error.message, 'error');
            }
        };

        // =============================================
        // ===== THEME =====
        // =============================================
        window.toggleTheme = () => {
            document.documentElement.classList.toggle('dark');
            const isDark = document.documentElement.classList.contains('dark');
            localStorage.setItem('theme', isDark ? 'dark' : 'light');
            document.querySelector('#menuBtn + button i').className = isDark ? 'fas fa-sun' : 'fas fa-moon';
        };

        // استعادة الثيم
        if (localStorage.getItem('theme') === 'dark') {
            document.documentElement.classList.add('dark');
        }

        // =============================================
        // ===== DEVICES =====
        // =============================================
        window.showDevices = () => {
            openModal(`
                <h2 class="text-xl font-bold text-dark mb-4 text-center">📱 الأجهزة المتصلة</h2>
                <div class="space-y-3">
                    <div class="flex items-center gap-3 p-3 bg-gray-50 rounded-xl">
                        <i class="fas fa-laptop text-blue-600 text-xl"></i>
                        <div class="flex-1">
                            <p class="font-bold text-dark">جهاز الحالي</p>
                            <p class="text-xs text-dark-light">Chrome على Windows</p>
                        </div>
                        <span class="text-xs bg-green-100 text-green-700 px-2 py-1 rounded">نشط</span>
                    </div>
                    <div class="flex items-center gap-3 p-3 bg-gray-50 rounded-xl">
                        <i class="fas fa-mobile-alt text-blue-600 text-xl"></i>
                        <div class="flex-1">
                            <p class="font-bold text-dark">iPhone 14 Pro</p>
                            <p class="text-xs text-dark-light">آخر استخدام: منذ يومين</p>
                        </div>
                        <span class="text-xs bg-gray-200 text-gray-700 px-2 py-1 rounded">غير نشط</span>
                    </div>
                </div>
                <button onclick="closeModal()" class="w-full py-2 mt-4 text-dark-light hover:text-dark">إغلاق</button>
            `);
        };

        // =============================================
        // ===== AUTH STATE =====
        // =============================================
        onAuthStateChanged(auth, async (user) => {
            loadingScreen.style.display = 'none';

            if (user) {
                currentUser = user;
                loginScreen.style.display = 'none';
                mainApp.classList.remove('hidden');

                // الاستماع لتغييرات المستخدم
                onSnapshot(doc(db, "users", user.uid), (snap) => {
                    if (snap.exists()) {
                        const data = snap.data();
                        updateUI(data);
                        loadRecentTransactions();
                        loadCards();
                    }
                });

            } else {
                loginScreen.style.display = 'flex';
                mainApp.classList.add('hidden');
                currentUser = null;
                userData = null;
            }
        });

        console.log('🏦 Global Wallet جاهز!');
        console.log('✅ المحفظة الإلكترونية تعمل بنجاح!');
    </script>

</body>
</html>
