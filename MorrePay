        // تسجيل الدخول
        loginForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            const email = document.getElementById('loginEmail').value.trim();
            const password = document.getElementById('loginPassword').value;
            const btn = loginForm.querySelector('button[type="submit"]');
            btn.innerHTML = '<i class="fas fa-spinner fa-spin ml-2"></i> جاري تسجيل الدخول...';
            btn.disabled = true;

            try {
                await signInWithEmailAndPassword(auth, email, password);
                showToast('✅ تم تسجيل الدخول بنجاح!', 'success');
            } catch (error) {
                let msg = '❌ خطأ في تسجيل الدخول';
                if (error.code === 'auth/user-not-found') msg = '❌ هذا البريد غير مسجل';
                else if (error.code === 'auth/wrong-password') msg = '❌ كلمة المرور غير صحيحة';
                else if (error.code === 'auth/invalid-email') msg = '❌ البريد الإلكتروني غير صحيح';
                showToast(msg, 'error');
            } finally {
                btn.innerHTML = '<i class="fas fa-sign-in-alt ml-2"></i> تسجيل الدخول';
                btn.disabled = false;
            }
        });

        // إنشاء حساب
        registerForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            const name = document.getElementById('regName').value.trim();
            const email = document.getElementById('regEmail').value.trim();
            const phone = document.getElementById('regPhone').value.trim();
            const password = document.getElementById('regPassword').value;
            const confirm = document.getElementById('regConfirm').value;

            if (password !== confirm) {
                showToast('❌ كلمتا المرور غير متطابقتين', 'error');
                return;
            }
            if (password.length < 6) {
                showToast('❌ كلمة المرور يجب أن تكون 6 أحرف على الأقل', 'error');
                return;
            }

            const btn = registerForm.querySelector('button[type="submit"]');
            btn.innerHTML = '<i class="fas fa-spinner fa-spin ml-2"></i> جاري إنشاء الحساب...';
            btn.disabled = true;

            try {
                const userCredential = await createUserWithEmailAndPassword(auth, email, password);
                const user = userCredential.user;
                const walletID = Math.floor(100000 + Math.random() * 900000).toString();

                await setDoc(doc(db, "users", user.uid), {
                    name: name,
                    email: email,
                    phone: phone,
                    walletID: walletID,
                    balance: 100000, // رصيد تجريبي
                    frozenBalance: 0,
                    currency: 'SDG',
                    isVerified: false,
                    kycStatus: 'pending',
                    dailyLimit: 100000,
                    monthlyLimit: 1000000,
                    dailyUsed: 0,
                    monthlyUsed: 0,
                    createdAt: serverTimestamp(),
                    lastLogin: serverTimestamp()
                });

                showToast(`✅ تم إنشاء الحساب بنجاح! #${walletID}`, 'success');
            } catch (error) {
                let msg = '❌ خطأ في إنشاء الحساب';
                if (error.code === 'auth/email-already-in-use') msg = '❌ هذا البريد مستخدم بالفعل';
                else if (error.code === 'auth/invalid-email') msg = '❌ البريد الإلكتروني غير صحيح';
                showToast(msg, 'error');
            } finally {
                btn.innerHTML = '<i class="fas fa-user-plus ml-2"></i> إنشاء الحساب';
                btn.disabled = false;
            }
        });

        // نسيان كلمة المرور
        window.forgotPassword = async () => {
            const email = prompt('📧 أدخل بريدك الإلكتروني:');
            if (!email) return;
            try {
                await sendPasswordResetEmail(auth, email);
                showToast('✅ تم إرسال رابط إعادة التعيين إلى بريدك', 'success');
            } catch (error) {
                showToast('❌ خطأ: ' + error.message, 'error');
            }
        };

        // تغيير كلمة المرور
        window.changePassword = async () => {
            if (!auth.currentUser) {
                showToast('❌ يرجى تسجيل الدخول أولاً', 'error');
                return;
            }
            const newPassword = prompt('🔑 أدخل كلمة المرور الجديدة (6 أحرف على الأقل):');
            if (!newPassword || newPassword.length < 6) {
                showToast('❌ كلمة المرور يجب أن تكون 6 أحرف على الأقل', 'error');
                return;
            }
            try {
                await updatePassword(auth.currentUser, newPassword);
                showToast('✅ تم تغيير كلمة المرور بنجاح', 'success');
            } catch (error) {
                showToast('❌ خطأ: ' + error.message, 'error');
            }
        };

        // تسجيل الخروج
        window.logout = async () => {
            if (confirm('⚠️ هل أنت متأكد من تسجيل الخروج؟')) {
                await signOut(auth);
                location.reload();
            }
        };

        // =============================================
        // ===== USER DATA =====
        // =============================================
        function updateUI(data) {
            userData = data;
            document.getElementById('balanceDisplay').innerText = (data.balance || 0).toLocaleString();
            document.getElementById('walletID').innerText = `#${data.walletID || '000000'}`;
            document.getElementById('cardHolderName').innerText = data.name || 'مستخدم';
            document.getElementById('cardNumberDisplay').innerText = `•••• •••• •••• ${data.walletID ? data.walletID.slice(-4) : '4242'}`;
            document.getElementById('cardExpiry').innerText = '12/26';
            document.getElementById('kycStatus').innerText = data.isVerified ? '✅ موثق' : '⚠️ غير موثق';
            document.getElementById('kycStatus').style.background = data.isVerified ? 'rgba(22,163,74,0.3)' : 'rgba(239,68,68,0.3)';
            document.getElementById('dailyUsed').innerText = (data.dailyUsed || 0).toLocaleString();
            document.getElementById('monthlyLimit').innerText = (data.monthlyLimit || 0).toLocaleString();

            // تحديث الملف الشخصي
            document.getElementById('profileName').innerText = data.name || 'مستخدم';
            document.getElementById('profileWallet').innerText = `#${data.walletID || '000000'}`;
            document.getElementById('profileBalance').innerText = `${(data.balance || 0).toLocaleString()} ج.س`;
            document.getElementById('profileImg').src = `https://ui-avatars.com/api/?name=${encodeURIComponent(data.name || 'U')}&size=100&background=1A73E8&color=fff&bold=true`;

            // تحديث حالة المصادقة الثنائية
            document.getElementById('twoFAStatus').innerText = data.twoFactorEnabled ? '✅ مفعلة' : '❌ غير مفعلة';
            document.getElementById('twoFAStatus').style.color = data.twoFactorEnabled ? '#16A34A' : '#EF4444';
        }

        // =============================================
        // ===== WALLET FUNCTIONS =====
        // =============================================

        // تحويل أموال
        window.processTransfer = async () => {
            if (!auth.currentUser) {
                showToast('❌ يرجى تسجيل الدخول أولاً', 'error');
                return;
            }

            const receiverWallet = document.getElementById('transferWallet').value.trim();
            const amount = parseFloat(document.getElementById('transferAmount').value);
            const description = document.getElementById('transferDesc').value.trim() || 'تحويل';

            if (!receiverWallet) {
                showToast('❌ أدخل رقم المحفظة', 'error');
                return;
            }
            if (!amount || amount <= 0) {
                showToast('❌ المبلغ غير صحيح', 'error');
                return;
            }
            if (amount > (userData?.balance || 0)) {
                showToast('❌ الرصيد غير كافي', 'error');
                return;
            }

            if (!confirm(`تأكيد تحويل ${amount.toLocaleString()} ج.س إلى المحفظة #${receiverWallet}`)) return;

            try {
                const result = await runTransaction(db, async (transaction) => {
                    // 1. التحقق من المرسل
                    const senderRef = doc(db, "users", auth.currentUser.uid);
                    const senderDoc = await transaction.get(senderRef);
                    if (!senderDoc.exists) throw new Error('المرسل غير موجود');
                    const senderData = senderDoc.data();
                    if (senderData.balance < amount) throw new Error('الرصيد غير كافي');

                    // 2. البحث عن المستلم
                    const receiverQuery = await getDocs(query(collection(db, "users"), where("walletID", "==", receiverWallet)));
                    if (receiverQuery.empty) throw new Error('رقم المحفظة غير صحيح');
                    const receiverRef = receiverQuery.docs[0].ref;
                    const receiverDoc = await transaction.get(receiverRef);
                    const receiverData = receiverDoc.data();

                    // 3. خصم من المرسل
                    const senderNewBalance = senderData.balance - amount;
                    transaction.update(senderRef, {
                        balance: senderNewBalance,
                        dailyUsed: increment(amount),
                        monthlyUsed: increment(amount),
                        updatedAt: serverTimestamp()
                    });

                    // 4. إضافة للمستلم
                    const receiverNewBalance = (receiverData.balance || 0) + amount;
                    transaction.update(receiverRef, {
                        balance: receiverNewBalance,
                        updatedAt: serverTimestamp()
                    });

                    // 5. إنشاء عملية
                    const txnRef = doc(collection(db, "transactions"));
                    const txnData = {
                        id: txnRef.id,
                        reference: `TXN-${Date.now()}-${Math.random().toString(36).substr(2, 6)}`,
                        senderId: auth.currentUser.uid,
                        senderWalletID: senderData.walletID,
                        receiverId: receiverQuery.docs[0].id,
                        receiverWalletID: receiverWallet,
                        amount: amount,
                        fee: 0,
                        netAmount: amount,
                        currency: 'SDG',
                        type: 'transfer',
                        status: 'completed',
                        description: description,
                        createdAt: serverTimestamp(),
                        completedAt: serverTimestamp()
                    };
                    transaction.set(txnRef, txnData);

                    // 6. سجل الدفتر للمرسل
                    const ledgerSender = doc(collection(db, "ledger"));
                    transaction.set(ledgerSender, {
                        userId: auth.currentUser.uid,
                        transactionId: txnRef.id,
                        walletId: senderData.walletID,
                        amount: amount,
                        balanceBefore: senderData.balance,
                        balanceAfter: senderNewBalance,
                        type: 'debit',
                        description: `تحويل إلى #${receiverWallet}`,
                        createdAt: serverTimestamp()
                    });

                    // 7. سجل الدفتر للمستلم
                    const ledgerReceiver = doc(collection(db, "ledger"));
                    transaction.set(ledgerReceiver, {
                        userId: receiverQuery.docs[0].id,
                        transactionId: txnRef.id,
                        walletId: receiverWallet,
                        amount: amount,
                        balanceBefore: receiverData.balance || 0,
                        balanceAfter: receiverNewBalance,
                        type: 'credit',
                        description: `استلام من #${senderData.walletID}`,
                        createdAt: serverTimestamp()
                    });

                    return { success: true, senderNewBalance, txnId: txnRef.id };
                });

                if (result.success) {
                    showToast(`✅ تم تحويل ${amount.toLocaleString()} ج.س بنجاح`, 'success');
                    document.getElementById('transferWallet').value = '';
                    document.getElementById('transferAmount').value = '';
                    document.getElementById('transferDesc').value = '';
                    // تحديث الرصيد
                    if (userData) {
                        userData.balance = result.senderNewBalance;
                        document.getElementById('balanceDisplay').innerText = result.senderNewBalance.toLocaleString();
                        document.getElementById('profileBalance').innerText = `${result.senderNewBalance.toLocaleString()} ج.س`;
                    }
                    loadRecentTransactions();
                }
            } catch (error) {
                showToast('❌ ' + error.message, 'error');
            }
        };

